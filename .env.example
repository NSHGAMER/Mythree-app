# ---------------------------------------------------------------------------
# Mythree – environment variables (copy to .env.local for local development)
# NEVER commit real values. Production values live in Vercel / Supabase settings.
# ---------------------------------------------------------------------------

# --- Frontend (Vite, public – safe to expose to the browser) ---------------
# Supabase project URL and PUBLISHABLE (anon) key. Never put the service role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Cloudflare Turnstile SITE key (public). Empty = CAPTCHA off. The SECRET key goes only into Supabase
# (Authentication → Attack Protection), never here. See docs/TURNSTILE_SETUP.md
VITE_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets (set with `supabase secrets set` or the dashboard:
# Project Settings → Edge Functions → Secrets). Not used by the browser.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically.
# ---------------------------------------------------------------------------

# Restrict CORS to your site(s), comma separated
ALLOWED_ORIGINS=https://mythree.vercel.app

# Razorpay (Guru Dakshina). Use rzp_test_ keys until go-live.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# SMS OTP: msg91 | twilio | console (console = development only, also needs OTP_ALLOW_CONSOLE=true)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
OTP_ALLOW_CONSOLE=false
# Random secret mixed into OTP hashes (32+ chars)
OTP_PEPPER=

# Optional: email the organisation when a member declares final-exam readiness (Resend)
RESEND_API_KEY=
ADMIN_NOTIFY_EMAILS=office@example.org
NOTIFY_FROM_EMAIL=Mythree <noreply@your-domain.org>

# --- Load testing only (never commit) ---------------------------------------
# LOADTEST_PASSWORD=
